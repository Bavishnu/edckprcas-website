# Copy this file to .env for local testing only. Never commit .env.
# Replace this with the exact Pages hostname Cloudflare assigns.
SITE_URL=https://edckprcas-website.pages.dev

# No R2 needed: media is stored in public/uploads and served from this same site.
# Normally this is identical to SITE_URL.
MEDIA_BASE_URL=https://edckprcas-website.pages.dev

# Resend email values are needed only after a verified sender domain and API key exist.
# Do not use the Resend test sender for public enquiries to institutional addresses.
RESEND_API_KEY=PASTE_YOUR_RESEND_API_KEY_HERE
MAIL_FROM=EDCKPRCAS Website <website@send.kprcas.ac.in>
MAIL_TO=edc@kprcas.ac.in

# Exact browser origins allowed to submit the contact form.
# After connecting the final domain, include all live origins separated by commas.
ALLOWED_ORIGINS=https://edckprcas-website.pages.dev
